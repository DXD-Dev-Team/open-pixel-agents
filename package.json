{
  "name": "office-pixel-agents",
  "displayName": "The Office \u2014 Pixel Agents",
  "description": "Local pixel office for OpenCode workers, with the Office Desk integration bridge.",
  "version": "0.0.2",
  "publisher": "dxd-dev-team",
  "repository": {
    "type": "git",
    "url": "https://github.com/DXD-Dev-Team/open-pixel-agents"
  },
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "office-pixel-agents.showPanel",
        "title": "Open Pixel Agents: Show Panel"
      },
      {
        "command": "office-pixel-agents.exportDefaultLayout",
        "title": "Open Pixel Agents: Export Layout as Default"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "office-pixel-agents-panel",
          "title": "The Office",
          "icon": "$(window)"
        }
      ]
    },
    "views": {
      "office-pixel-agents-panel": [
        {
          "type": "webview",
          "id": "office-pixel-agents.panelView",
          "name": "The Office"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build:webview": "cd webview-ui && npm run build",
    "compile": "npm run check-types && npm run lint && node esbuild.js && npm run build:webview",
    "build": "npm run compile",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && npm run build:webview",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "import-tileset": "tsx scripts/import-tileset-cli.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@types/node": "22.x",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.50.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
